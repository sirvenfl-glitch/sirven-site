---
interface Props {
  currentPage?: 'home' | 'contact';
}
const { currentPage = 'home' } = Astro.props;
---

<nav id="main-nav">
  <a href="/" class="nav-logo">Sirven</a>
  <div class="nav-right">
    <a href="https://www.linkedin.com/in/sirven-ouamba/" target="_blank" rel="noopener" class="nav-linkedin" aria-label="LinkedIn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
      </svg>
    </a>
    {currentPage === 'contact' ? (
      <a href="/" class="nav-back">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="nav-back-label" data-fr="Retour" data-en="Back">Retour</span>
      </a>
    ) : (
      <a href="/contact" class="nav-cta" data-fr="Démarrer un projet" data-en="Start a project">Démarrer un projet</a>
    )}
    <div class="lang-toggle">
      <button class="lang-btn active" id="btn-fr" onclick="setLang('fr')">FR</button>
      <button class="lang-btn" id="btn-en" onclick="setLang('en')">EN</button>
    </div>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 24px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: padding 0.3s;
  }
  nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10,10,9,0.97) 0%, transparent 100%);
    pointer-events: none;
  }
  nav.scrolled { padding: 16px 40px; }
  nav.scrolled::before { background: rgba(10,10,9,0.97); }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--fg);
    text-decoration: none;
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
    position: relative;
    z-index: 1;
  }
  .nav-linkedin {
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.2s;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .nav-linkedin:hover { color: var(--fg); }
  .nav-cta {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .nav-cta:hover { color: var(--fg); }
  .nav-back {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.2s;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .nav-back:hover { color: var(--fg); }
  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 2px;
    background: rgba(242,237,228,0.06);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 4px 6px;
    flex-shrink: 0;
  }
  .lang-btn {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 4px 9px;
    border-radius: 100px;
    border: none;
    background: transparent;
    color: var(--fg-muted);
    cursor: none;
    transition: all 0.2s;
  }
  .lang-btn.active { background: var(--accent); color: var(--bg); }

  @media (max-width: 768px) {
    nav { padding: 18px 20px; }
    nav.scrolled { padding: 14px 20px; }
    .nav-cta { display: none; }
    .nav-back-label { display: none; }
    .nav-right { gap: 14px; }
  }
</style>

<script>
  // Scroll shrink
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 60);
  }, { passive: true });

  function setLang(lang: string) {
    document.documentElement.lang = lang;
    document.getElementById('btn-fr')?.classList.toggle('active', lang === 'fr');
    document.getElementById('btn-en')?.classList.toggle('active', lang === 'en');
    document.querySelectorAll('[data-fr]').forEach((el) => {
      const val = el.getAttribute('data-' + lang);
      if (val) el.innerHTML = val;
    });
  }
  (window as any).setLang = setLang;
</script>
