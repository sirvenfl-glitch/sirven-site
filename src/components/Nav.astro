---
interface Props {
  currentPage?: 'home' | 'contact';
}
const { currentPage = 'home' } = Astro.props;
---

<nav>
  <a href="/" class="nav-logo">Sirven</a>
  <div class="nav-right">
    {currentPage === 'contact' ? (
      <a href="/" class="nav-back">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span data-fr="Retour" data-en="Back">Retour</span>
      </a>
    ) : (
      <a href="/contact" class="nav-contact" data-fr="Démarrer un projet" data-en="Start a project">Démarrer un projet</a>
    )}
    <div class="lang-toggle">
      <button class="lang-btn active" id="btn-fr" onclick="setLang('fr')">FR</button>
      <button class="lang-btn" id="btn-en" onclick="setLang('en')">EN</button>
    </div>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 28px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10,10,9,0.97) 0%, transparent 100%);
    pointer-events: none;
  }
  .nav-logo {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--fg);
    text-decoration: none;
    position: relative;
    z-index: 1;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 24px;
    position: relative;
    z-index: 1;
  }
  .nav-contact {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-contact:hover { color: var(--fg); }
  .nav-back {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.2s;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-back:hover { color: var(--fg); }
  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 2px;
    background: rgba(242,237,228,0.06);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 4px 6px;
  }
  .lang-btn {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 4px 10px;
    border-radius: 100px;
    border: none;
    background: transparent;
    color: var(--fg-muted);
    cursor: none;
    transition: all 0.2s;
  }
  .lang-btn.active { background: var(--accent); color: var(--bg); }
  @media (max-width: 900px) {
    nav { padding: 20px 24px; }
  }
</style>

<script>
  function setLang(lang: string) {
    document.documentElement.lang = lang;
    document.getElementById('btn-fr')?.classList.toggle('active', lang === 'fr');
    document.getElementById('btn-en')?.classList.toggle('active', lang === 'en');
    document.querySelectorAll('[data-fr]').forEach((el) => {
      const val = el.getAttribute('data-' + lang);
      if (val) el.innerHTML = val;
    });
  }
  (window as any).setLang = setLang;
</script>
