---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';

const projects = [
  { url: 'https://www.flaynn.fr/', tag: 'SaaS', name: 'Flaynn', domain: 'flaynn.fr', angle: 'Plateforme startup-investisseur, de zéro à live' },
  { url: 'https://proprio-link.fr/', tag: 'Immobilier', name: 'Proprio Link', domain: 'proprio-link.fr', angle: 'Crédibilité immédiate pour capter des mandats' },
  { url: 'https://www.secoursparebrise.fr/', tag: 'Services auto', name: 'Secours Pare-Brise', domain: 'secoursparebrise.fr', angle: 'Site vitrine pensé pour la prise de contact' },
  { url: 'https://4dayvelopment.com/', tag: 'Agence digitale', name: '4Dayvelopment', domain: '4dayvelopment.com', angle: 'Positionnement vitesse + qualité traduit en design' },
  { url: 'https://composeparis.fr/', tag: 'Restaurant', name: 'Compose Paris', domain: 'composeparis.fr', angle: 'Ambiance premium pour attirer les bons clients' },
  { url: 'https://emoi-agency.fr/', tag: 'Agence digitale', name: 'Emoi Agency', domain: 'emoi-agency.fr', angle: 'Identité forte pour une agence en lancement' },
  { url: 'https://inspiofficiel.fr/', tag: 'Collectif cinéma', name: 'Inspi Officiel', domain: 'inspiofficiel.fr', angle: 'Présence digitale qui reflète l\'univers créatif' },
  { url: 'https://thiepsrestaurant.fr/', tag: 'Restaurant', name: "Thiep's Restaurant", domain: 'thiepsrestaurant.fr', angle: 'Refonte orientée réservation et découverte' },
];
---

<Base title="Sirven — Web & IA">
  <Nav currentPage="home" />

  <!-- HERO -->
  <section class="page-section hero">
    <div class="container hero-content">
      <p class="hero-eyebrow" data-fr="Sites web · Automatisation · IA" data-en="Websites · Automation · AI">Sites web · Automatisation · IA</p>
      <h1 class="hero-title" data-fr="Je construis des sites qui donnent <em>envie de vous choisir</em> avant même le premier échange." data-en="I build websites that make people <em>choose you</em> before the first word is said.">
        Je construis des sites qui donnent <em>envie de vous choisir</em> avant même le premier échange.
      </h1>
      <p class="hero-sub" data-fr="Vous avez quelque chose de sérieux à proposer. Votre présence en ligne devrait le montrer avant que vous ayez à l'expliquer." data-en="You have something real to offer. Your online presence should show it before you have to explain it.">
        Vous avez quelque chose de sérieux à proposer. Votre présence en ligne devrait le montrer avant que vous ayez à l'expliquer.
      </p>
      <p class="hero-cadrage" data-fr="Pour marques, agences et business qui veulent être pris au sérieux dès le premier regard." data-en="For brands, agencies and businesses that want to be taken seriously from the very first glance.">
        Pour marques, agences et business qui veulent être pris au sérieux dès le premier regard.
      </p>
      <a href="/contact" class="hero-cta js-magnetic">
        <span data-fr="Démarrer un projet" data-en="Start a project">Démarrer un projet</span>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
    <div class="hero-bg-line"></div>
    <div class="hero-scroll">
      <div class="scroll-line"></div>
      <span>Scroll</span>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="page-section section">
    <div class="container">
      <p class="section-label reveal" data-fr="Services" data-en="Services">Services</p>
      <div class="services-grid">
        <div class="service-card reveal reveal-delay-1">
          <p class="service-num">01</p>
          <h2 class="service-title" data-fr="Sites web" data-en="Websites">Sites web</h2>
          <p class="service-desc" data-fr="Vos visiteurs décident en quelques secondes si vous êtes crédibles. Je construis des sites qui gagnent ce verdict dès le premier scroll." data-en="Your visitors decide in seconds whether you're worth their time. I build sites that win that verdict on the first scroll.">
            Vos visiteurs décident en quelques secondes si vous êtes crédibles. Je construis des sites qui gagnent ce verdict dès le premier scroll.
          </p>
        </div>
        <div class="service-card reveal reveal-delay-2">
          <p class="service-num">02</p>
          <h2 class="service-title" data-fr="Automatisation IA" data-en="AI Automation">Automatisation IA</h2>
          <p class="service-desc" data-fr="Chaque message sans réponse, chaque rendez-vous raté, c'est du business perdu. Je mets en place des automatisations simples qui capturent ces opportunités à votre place." data-en="Every unanswered message, every missed booking is lost business. I set up simple automations that capture those opportunities for you.">
            Chaque message sans réponse, chaque rendez-vous raté, c'est du business perdu. Je mets en place des automatisations simples qui capturent ces opportunités à votre place.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="page-section section proof-section">
    <div class="container">
      <p class="section-label reveal" data-fr="Pourquoi ça marche" data-en="Why it works">Pourquoi ça marche</p>
      <div class="proof-grid">
        <div class="proof-stat reveal reveal-delay-1">
          <span class="proof-num js-count" data-target="8">0</span>
          <span class="proof-unit" data-fr="projets livrés" data-en="projects delivered">projets livrés</span>
          <p class="proof-desc" data-fr="Des secteurs différents, une exigence constante." data-en="Different industries, constant standards.">Des secteurs différents, une exigence constante.</p>
        </div>
        <div class="proof-stat reveal reveal-delay-2">
          <span class="proof-num js-count" data-target="4">0</span>
          <span class="proof-unit" data-fr="jours en moyenne" data-en="days on average">jours en moyenne</span>
          <p class="proof-desc" data-fr="De la validation du brief à la mise en ligne." data-en="From brief validation to going live.">De la validation du brief à la mise en ligne.</p>
        </div>
        <div class="proof-stat reveal reveal-delay-3">
          <span class="proof-num">100</span><span class="proof-num-suffix">%</span>
          <span class="proof-unit" data-fr="sur-mesure" data-en="custom-built">sur-mesure</span>
          <p class="proof-desc" data-fr="Pas de template. Chaque site est construit pour votre contexte." data-en="No templates. Every site is built for your context.">Pas de template. Chaque site est construit pour votre contexte.</p>
        </div>
      </div>
      <div class="proof-quote reveal">
        <p class="quote-text" data-fr="&ldquo;Ce que vous voyez ici, c'est ce que vous obtenez. Pas de sous-traitance, pas de template amélioré — juste du travail fait avec soin et méthode.&rdquo;" data-en="&ldquo;What you see here is what you get. No outsourcing, no upgraded templates — just work done with care and method.&rdquo;">
          &ldquo;Ce que vous voyez ici, c'est ce que vous obtenez. Pas de sous-traitance, pas de template amélioré — juste du travail fait avec soin et méthode.&rdquo;
        </p>
        <span class="quote-author">— Sirven</span>
      </div>
    </div>
  </section>

  <!-- WORKS -->
  <section class="page-section section">
    <div class="container">
      <div class="works-header reveal">
        <h2 class="works-title" data-fr="Quelques projets." data-en="Selected work.">Quelques projets.</h2>
        <p class="works-subtitle" data-fr="Des secteurs différents. Un seul standard." data-en="Different industries. One standard.">Des secteurs différents. Un seul standard.</p>
      </div>
      <div class="works-grid">
        {projects.map((p, i) => (
          <a href={p.url} target="_blank" rel="noopener" class={`work-item js-tilt reveal reveal-delay-${(i % 4) + 1}`}>
            <div class="work-arrow-icon">
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none">
                <path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span class="work-tag">{p.tag}</span>
            <div class="work-info">
              <p class="work-name">{p.name}</p>
              <p class="work-angle">{p.angle}</p>
              <p class="work-domain">{p.domain}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="page-section reveal">
    <div class="container">
      <div class="cta-inner">
        <h2 class="cta-title" data-fr="Vous avez un projet&nbsp;en tête&nbsp;?" data-en="Got something&nbsp;in mind?">Vous avez un projet&nbsp;en tête&nbsp;?</h2>
        <p class="cta-sub" data-fr="Prenons 20 minutes pour voir ce qu'on peut faire." data-en="Let's take 20 minutes and see what we can build.">Prenons 20 minutes pour voir ce qu'on peut faire.</p>
        <a href="/contact" class="cta-btn js-magnetic">
          <span data-fr="Démarrer un projet" data-en="Start a project">Démarrer un projet</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: 80px;
    position: relative;
    overflow: hidden;
  }
  .hero-bg-line {
    position: absolute;
    top: 50%; left: -10%;
    width: 120%; height: 1px;
    background: var(--border);
    transform: rotate(-6deg);
    pointer-events: none;
  }
  .hero-content { position: relative; z-index: 2; }
  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 28px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s ease forwards 0.3s;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(34px, 6vw, 88px);
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: var(--fg);
    max-width: 900px;
    margin-bottom: 32px;
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUp 0.9s ease forwards 0.5s;
  }
  .hero-title :global(em) { font-style: normal; color: var(--accent); }
  .hero-sub {
    font-size: clamp(14px, 1.4vw, 17px);
    font-weight: 300;
    color: var(--fg-muted);
    max-width: 500px;
    line-height: 1.75;
    margin-bottom: 20px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s ease forwards 0.8s;
  }
  .hero-cadrage {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
    border-left: 2px solid var(--accent);
    padding-left: 14px;
    margin-bottom: 36px;
    max-width: 440px;
    line-height: 1.65;
    opacity: 0;
    transform: translateY(16px);
    animation: fadeUp 0.8s ease forwards 1.0s;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--bg);
    background: var(--accent);
    padding: 16px 32px;
    border-radius: 100px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
    opacity: 0;
    animation: fadeUp 0.8s ease forwards 1.1s;
    will-change: transform;
  }
  .hero-scroll {
    position: absolute;
    bottom: 36px; right: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: fadeUp 0.8s ease forwards 1.3s;
  }
  .hero-scroll span {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--fg-muted);
    text-transform: uppercase;
    writing-mode: vertical-lr;
  }
  .scroll-line { width: 1px; height: 56px; background: var(--border); position: relative; overflow: hidden; }
  .scroll-line::after {
    content: '';
    position: absolute;
    top: -100%; left: 0;
    width: 100%; height: 100%;
    background: var(--accent);
    animation: scrollAnim 1.8s ease-in-out infinite;
  }
  @keyframes scrollAnim { 0% { top: -100%; } 100% { top: 100%; } }
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

  /* SECTION */
  .section { padding: 120px 0; }
  .section-label {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 56px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .section-label::after { content: ''; flex: 1; height: 1px; background: var(--border); max-width: 80px; }

  /* SERVICES */
  .services-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .service-card {
    border: 1px solid var(--border);
    padding: 52px 44px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.4s;
  }
  .service-card:first-child { border-right: none; }
  .service-card::before { content: ''; position: absolute; inset: 0; background: var(--accent-glow); opacity: 0; transition: opacity 0.4s; }
  .service-card:hover { border-color: var(--border-hover); }
  .service-card:hover::before { opacity: 1; }
  .service-num { font-family: var(--font-display); font-size: 11px; font-weight: 600; letter-spacing: 0.2em; color: var(--fg-muted); margin-bottom: 28px; }
  .service-title { font-family: var(--font-display); font-size: clamp(22px, 2.8vw, 36px); font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 20px; color: var(--fg); }
  .service-desc { font-size: 15px; font-weight: 300; color: var(--fg-muted); line-height: 1.75; }

  /* PROOF */
  .proof-section { padding-top: 0; }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-bottom: 48px;
  }
  .proof-stat {
    border: 1px solid var(--border);
    padding: 40px 36px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s;
  }
  .proof-stat:not(:last-child) { border-right: none; }
  .proof-stat:hover { border-color: var(--border-hover); }
  .proof-num {
    font-family: var(--font-display);
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--fg);
    line-height: 1;
    display: inline-block;
  }
  .proof-num-suffix {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.03em;
  }
  .proof-unit {
    display: block;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 8px;
    margin-bottom: 16px;
  }
  .proof-desc { font-size: 13px; font-weight: 300; color: var(--fg-muted); line-height: 1.65; }
  .proof-quote {
    border: 1px solid var(--border);
    padding: 40px 48px;
    position: relative;
  }
  .proof-quote::before {
    content: '"';
    position: absolute;
    top: -24px; left: 40px;
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: 800;
    color: var(--accent);
    opacity: 0.3;
    line-height: 1;
  }
  .quote-text {
    font-family: var(--font-display);
    font-size: clamp(15px, 1.6vw, 20px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.55;
    color: var(--fg);
    margin-bottom: 16px;
    max-width: 720px;
  }
  .quote-author {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  /* WORKS */
  .works-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; }
  .works-title { font-family: var(--font-display); font-size: clamp(28px, 4vw, 56px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  .works-subtitle { font-size: 13px; font-weight: 300; color: var(--fg-muted); text-align: right; max-width: 160px; line-height: 1.6; }
  .works-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
  .work-item {
    border: 1px solid var(--border);
    padding: 28px 24px;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    color: var(--fg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.3s;
    aspect-ratio: 3 / 4;
    gap: 12px;
    will-change: transform;
  }
  .work-item:not(:last-child) { border-right: none; }
  .work-item:nth-child(n+5) { border-top: none; }
  .work-item::before { content: ''; position: absolute; inset: 0; background: var(--accent-glow); opacity: 0; transition: opacity 0.4s; }
  .work-item:hover { border-color: var(--border-hover); }
  .work-item:hover::before { opacity: 1; }
  .work-item:hover .work-arrow-icon { transform: translate(2px, -2px); border-color: var(--border-active); }
  .work-arrow-icon {
    position: absolute;
    top: 20px; right: 20px;
    width: 26px; height: 26px;
    border: 1px solid var(--border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    transition: transform 0.3s, border-color 0.3s;
    z-index: 1;
    flex-shrink: 0;
  }
  .work-tag { font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--fg-muted); position: relative; z-index: 1; }
  .work-info { position: relative; z-index: 1; }
  .work-name { font-family: var(--font-display); font-size: clamp(13px, 1.3vw, 17px); font-weight: 700; letter-spacing: -0.01em; line-height: 1.2; margin-bottom: 6px; }
  .work-angle { font-size: 11px; color: var(--fg-muted); font-weight: 300; line-height: 1.5; margin-bottom: 8px; }
  .work-domain { font-size: 10px; color: var(--fg-muted); font-weight: 400; opacity: 0.6; font-family: var(--font-display); letter-spacing: 0.04em; }

  /* CTA */
  .cta-inner { padding: 120px 0; text-align: center; position: relative; }
  .cta-inner::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 1px; height: 80px; background: var(--border); }
  .cta-title { font-family: var(--font-display); font-size: clamp(26px, 4.5vw, 64px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 20px; max-width: 680px; margin-left: auto; margin-right: auto; }
  .cta-sub { font-size: 15px; font-weight: 300; color: var(--fg-muted); margin-bottom: 40px; }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--bg);
    background: var(--accent);
    padding: 18px 40px;
    border-radius: 100px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
    will-change: transform;
  }
  .cta-btn:hover { opacity: 0.9; }

  /* MOBILE */
  @media (max-width: 900px) {
    .services-grid { grid-template-columns: 1fr; }
    .service-card:first-child { border-right: 1px solid var(--border); border-bottom: none; }
    .service-card { padding: 36px 28px; }
    .proof-grid { grid-template-columns: 1fr 1fr; }
    .proof-stat:nth-child(3) { border-right: 1px solid var(--border); border-top: none; grid-column: 1 / -1; }
    .proof-stat:nth-child(2) { border-right: 1px solid var(--border); }
    .works-grid { grid-template-columns: repeat(2, 1fr); }
    .work-item { aspect-ratio: unset; min-height: 160px; padding: 20px 18px; }
    .work-item:nth-child(odd) { border-right: none; }
    .work-item:nth-child(2n) { border-right: 1px solid var(--border); }
    .work-item:nth-child(n+3) { border-top: none; }
    .works-header { flex-direction: column; align-items: flex-start; gap: 8px; margin-bottom: 32px; }
    .works-subtitle { text-align: left; max-width: 100%; }
    .section { padding: 72px 0; }
    .hero { min-height: 95vh; padding-bottom: 60px; }
    .hero-scroll { display: none; }
    .cta-inner { padding: 80px 0; }
    .proof-quote { padding: 32px 28px; }
  }

  @media (max-width: 480px) {
    .works-grid { grid-template-columns: 1fr; }
    .work-item { border-right: 1px solid var(--border) !important; min-height: auto; }
    .work-item:nth-child(n+2) { border-top: none !important; }
    .proof-grid { grid-template-columns: 1fr; }
    .proof-stat { border-right: 1px solid var(--border) !important; }
    .proof-stat:not(:last-child) { border-bottom: none; }
  }
</style>

<script>
  // MAGNETIC BUTTONS
  document.querySelectorAll('.js-magnetic').forEach((btn) => {
    const el = btn as HTMLElement;
    el.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = el.getBoundingClientRect();
      const x = (e.clientX - rect.left - rect.width / 2) * 0.2;
      const y = (e.clientY - rect.top - rect.height / 2) * 0.2;
      el.style.transform = `translate(${x}px, ${y}px) scale(1.04)`;
    });
    el.addEventListener('mouseleave', () => {
      el.style.transform = '';
    });
  });

  // TILT ON WORK CARDS
  document.querySelectorAll('.js-tilt').forEach((card) => {
    const el = card as HTMLElement;
    el.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = el.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      el.style.transform = `perspective(800px) rotateY(${x * 5}deg) rotateX(${-y * 5}deg) scale(1.01)`;
    });
    el.addEventListener('mouseleave', () => {
      el.style.transition = 'transform 0.4s ease';
      el.style.transform = '';
      setTimeout(() => { el.style.transition = ''; }, 400);
    });
  });

  // PARALLAX HERO
  const heroTitle = document.querySelector('.hero-title') as HTMLElement;
  const heroCadrage = document.querySelector('.hero-cadrage') as HTMLElement;
  if (heroTitle) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      heroTitle.style.transform = `translateY(${y * 0.1}px)`;
      if (heroCadrage) heroCadrage.style.transform = `translateY(${y * 0.06}px)`;
    }, { passive: true });
  }

  // COUNT UP ANIMATION
  const countEls = document.querySelectorAll('.js-count');
  const countObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const el = e.target as HTMLElement;
        const target = parseInt(el.dataset.target || '0');
        let start = 0;
        const duration = 1400;
        const startTime = performance.now();
        const tick = (now: number) => {
          const progress = Math.min((now - startTime) / duration, 1);
          const ease = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.floor(ease * target));
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        countObs.unobserve(el);
      }
    });
  }, { threshold: 0.5 });
  countEls.forEach(el => countObs.observe(el));

  // HORIZONTAL SCROLL HINT ON WORKS (mobile)
  const worksGrid = document.querySelector('.works-grid') as HTMLElement;
  if (worksGrid && window.innerWidth < 480) {
    worksGrid.style.overflowX = 'auto';
    worksGrid.style.display = 'flex';
    worksGrid.style.flexWrap = 'nowrap';
    document.querySelectorAll('.work-item').forEach(el => {
      (el as HTMLElement).style.minWidth = '72vw';
      (el as HTMLElement).style.borderRight = '1px solid var(--border)';
    });
  }
</script>
